{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
  "small_model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
  "autoupdate": "notify",
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B A55B",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 16384 }
        }
      }
    }
  },
  "compaction": { "auto": true, "prune": true },
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "cargo clean*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo fmt*": "allow",
      "cargo clippy*": "allow",
      "cargo build*": "allow",
      "./scripts/e2e_smoke.sh": "allow",
      "git push*": "allow",
      "git reset --hard*": "deny",
      "rm -rf*": "deny",
      "sudo *": "allow"
    }
  },
  "agent": {
    "build": { "temperature": 0.6 },
    "plan": {
      "temperature": 0.6,
      "permission": { "edit": "deny", "bash": { "*": "ask" } }
    },
    "review": {
      "description": "Revisor read-only de código Rust y seguridad",
      "mode": "subagent",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny", "git diff*": "allow", "cargo clippy*": "allow" }
      }
    }
  }
}